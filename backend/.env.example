# Copia este archivo como backend/.env y completa los valores. NUNCA subas el .env a GitHub.

# Conexión a PostgreSQL. Local: usuario:clave@localhost:5432/nombre_de_la_base
# En la nube (Neon) termina con ?sslmode=require
DATABASE_URL=postgresql+psycopg://usuario:clave@localhost:5432/adopcion_ecommerce

# Clave para firmar los tokens. Mínimo 16 caracteres. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Solo en producción: dirección de tu frontend (varias separadas por coma). Localhost ya viene incluido.
# CORS_ORIGINS=https://paws-shop.onrender.com
